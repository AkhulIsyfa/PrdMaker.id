# Application Environment
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=makeprd
DB_PASSWORD=makeprd_secret
DB_NAME=makeprd_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & Secrets
JWT_SECRET=makeprd_jwt_super_secret_key_minimum_32_characters_for_security
JWT_EXPIRES_IN=7d
CSRF_SECRET=makeprd_csrf_secret_salt_token_generator_key_32_chars

# Google AI Studio / Gemini Integration (Phase 4)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

